# Copy to .env and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API). The .env file is git-ignored.
#
# The anon key is the public, browser-safe key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security so the web server can draw test
# questions and score attempts without ever exposing the answer key to a
# trainee's client. It belongs ONLY on this trusted server (this .env) and must
# never be compiled into the mobile app. Without it, taking tests is disabled
# (creating and managing them still works).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the web app's session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=change-me

# --- Outgoing mail (invitation notices) ---
# Your own mail server. Without these, invitations still work — no mail is
# sent. Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=mail.your-domain.at
SMTP_PORT=587
SMTP_USER=noreply@your-domain.at
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=noreply@your-domain.at
SMTP_STARTTLS=1

# Used for links inside those e-mails, and as the default base URL the mobile
# app calls for taking tests (override with QM_API_BASE if they differ).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Where the mobile app reaches the test API. Defaults to PUBLIC_BASE_URL. On the
# iOS simulator http://127.0.0.1:8000 reaches the host; on a real device use the
# server's public URL. For packaged builds set app_config.API_BASE instead.
# QM_API_BASE=https://tests.your-domain.at
